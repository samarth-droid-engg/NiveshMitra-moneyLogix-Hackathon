# Backend API Base URL (leave empty for local dev with Vite proxy, or set your Render URL for production)
# Example: https://niveshmitra-backend.onrender.com
VITE_API_URL=

# Google OAuth 2.0 Web client ID (same value as backend GOOGLE_CLIENT_ID).
# Create at https://console.cloud.google.com/apis/credentials
#   Authorized JavaScript origins: http://localhost:5173, https://your-app.vercel.app
# Leave blank to hide the Google button and use email/password login.
VITE_GOOGLE_CLIENT_ID=

